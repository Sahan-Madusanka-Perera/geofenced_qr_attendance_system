# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=attendance_db
DB_USER=admin
DB_PASSWORD=attendance_secret_2024

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# QR Token Encryption — AES-256 needs a 32-byte key, i.e. 64 hex characters.
# Anything shorter fails with "Invalid key length" the first time a session
# starts. Generate your own with: openssl rand -hex 32
QR_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# QR Code
QR_REFRESH_INTERVAL_MS=10000
QR_TOKEN_TTL_SECONDS=15
